<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Safari Park Spanish — Flashcard Guessing Game</title>
  <style>
    :root{
      --bg:#0b1b2b; --card:#ffffff; --ink:#0f172a; --accent:#10b981; --accent-2:#60a5fa; --muted:#94a3b8;
    }
    *{box-sizing:border-box}
    body{
      margin:0; font-family: system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji","Segoe UI Emoji";
      background: radial-gradient(1200px 800px at 20% -10%, #17324f 0%, #0b1b2b 60%, #091725 100%);
      color:#e5e7eb; min-height:100svh; display:grid; place-items:center; padding:24px;
    }
    .app{width:min(920px, 100%);}
    header{display:flex; gap:16px; align-items:center; justify-content:space-between; margin-bottom:16px;}
    h1{font-size:clamp(20px,3vw,28px); margin:0; font-weight:800; letter-spacing:.2px}
    .controls{display:flex; flex-wrap:wrap; gap:10px; align-items:center}
    select,button,input[type="checkbox"]+label{font-size:14px}
    button, select{appearance:none; border:none; border-radius:12px; padding:10px 14px; background:#1f2937; color:#e5e7eb; box-shadow:0 1px 0 #0004 inset, 0 0 0 1px #ffffff10;}
    button.primary{background: linear-gradient(180deg, #16a34a, #0f9d58); box-shadow:0 6px 18px #16a34a40, inset 0 0 0 1px #ffffff30;}
    button.ghost{background:#0f172a;}
    button:disabled{opacity:.5}
    .card{
      background: var(--card); color:var(--ink); border-radius:24px; padding:20px; display:grid; grid-template-columns: 140px 1fr; gap:16px; align-items:center;
      box-shadow: 0 18px 60px #00000060, inset 0 0 0 1px #00000010; min-height:160px;
    }
    .svgbox{display:grid; place-items:center; background:#f1f5f9; border-radius:16px; height:120px}
    .term{display:flex; flex-direction:column; gap:6px}
    .term .es{font-size:22px; font-weight:800}
    .term .en{font-size:16px; color:#334155}
    .hint{font-size:13px; color:#6b7280}
    .options{display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:10px; margin-top:14px}
    .opt{background:#0f172a; color:#e5e7eb; border-radius:12px; padding:12px; cursor:pointer; border:1px solid #ffffff15}
    .opt.correct{outline:2px solid #10b981}
    .opt.wrong{outline:2px solid #ef4444}
    .status{display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; color:#cbd5e1; font-size:14px}
    .pill{display:inline-flex; align-items:center; gap:6px; padding:6px 10px; border-radius:999px; background:#0f172a; border:1px solid #ffffff15}
    .row{display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:12px}
    .grow{flex:1}
    .sr-only{position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0}
    footer{margin-top:14px; color:#94a3b8; font-size:12px}
    @media (max-width:640px){
      .card{grid-template-columns:1fr;}
    }
  </style>
</head>
<body>
  <div class="app" id="app">
    <header>
      <h1>Safari Park Spanish — Flashcard Guessing Game</h1>
      <div class="controls">
        <select id="mode">
          <option value="es2en">Guess English from Spanish</option>
          <option value="en2es">Guess Spanish from English</option>
          <option value="icon">Guess from Illustration</option>
        </select>
        <button id="shuffle" class="ghost" title="Shuffle order">Shuffle</button>
        <button id="speak" class="ghost" title="Speak Spanish term">🔊 Speak</button>
      </div>
    </header>

    <main>
      <section class="card" aria-live="polite">
        <div class="svgbox" id="icon" aria-hidden="true"></div>
        <div class="term">
          <div class="es" id="es">—</div>
          <div class="en" id="en">—</div>
          <div class="hint" id="hint">Choose the correct answer below.</div>
          <div class="options" id="options"></div>
          <div class="row">
            <button id="reveal">Reveal</button>
            <button id="next" class="primary">Next →</button>
            <span class="pill" id="progress">Card 1 / 7</span>
            <span class="pill" id="score">Score 0</span>
          </div>
        </div>
      </section>

      <footer>
        Phrases covered: <em>Vaya a</em> (Go to), <em>Doble a la derecha / izquierda</em> (Turn right / left), <em>Siga este camino</em> (Follow this path), <em>Al lado de</em> (Next to), <em>Enfrente de</em> (In front of), <em>Tome el ascensor</em> (Take the elevator), <em>Vaya derecho</em> (Go straight).
      </footer>
    </main>
  </div>

  <script>
  // --- Flashcard data with inline SVG icons ---
  const CARDS = [
    {
      es: 'Vaya a', en: 'Go to',
      svg: `<svg viewBox="0 0 128 128" width="96" height="96" xmlns="http://www.w3.org/2000/svg">
              <defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f59e0b"/><stop offset="1" stop-color="#ef4444"/></linearGradient></defs>
              <circle cx="64" cy="64" r="56" fill="#e2e8f0"/>
              <path d="M64 24a28 28 0 1 0 0 56a28 28 0 1 0 0-56z" fill="#fff" stroke="#111827" stroke-width="4"/>
              <circle cx="64" cy="52" r="10" fill="url(#g1)"/>
              <path d="M64 24c-16 0-28 12-28 28c0 24 28 52 28 52s28-28 28-52c0-16-12-28-28-28z" fill="none" stroke="#111827" stroke-width="4"/>
              <path d="M12 112h104" stroke="#94a3b8" stroke-width="6" stroke-linecap="round"/>
            </svg>`
    },
    {
      es: 'Doble a la derecha', en: 'Turn right',
      svg: `<svg viewBox="0 0 128 128" width="96" height="96" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="8" width="112" height="112" rx="16" fill="#e2e8f0"/>
              <path d="M40 92V52c0-12 8-20 20-20h16" fill="none" stroke="#111827" stroke-width="10" stroke-linecap="round"/>
              <path d="M68 20l24 20l-24 20" fill="none" stroke="#111827" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>`
    },
    {
      es: 'Doble a la izquierda', en: 'Turn left',
      svg: `<svg viewBox="0 0 128 128" width="96" height="96" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="8" width="112" height="112" rx="16" fill="#e2e8f0"/>
              <path d="M88 92V52c0-12-8-20-20-20H52" fill="none" stroke="#111827" stroke-width="10" stroke-linecap="round"/>
              <path d="M60 20l-24 20l24 20" fill="none" stroke="#111827" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>`
    },
    {
      es: 'Siga este camino', en: 'Follow this path',
      svg: `<svg viewBox="0 0 128 128" width="96" height="96" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="8" width="112" height="112" rx="16" fill="#dbeafe"/>
              <path d="M20 96c40-8 16-24 40-32s16-24 48-32" fill="none" stroke="#111827" stroke-width="8" stroke-linecap="round"/>
              <circle cx="100" cy="28" r="6" fill="#111827"/>
              <circle cx="24" cy="96" r="6" fill="#111827"/>
            </svg>`
    },
    {
      es: 'Al lado de', en: 'Next to',
      svg: `<svg viewBox="0 0 128 128" width="96" height="96" xmlns="http://www.w3.org/2000/svg">
              <rect x="12" y="24" width="44" height="72" rx="8" fill="#93c5fd" stroke="#111827" stroke-width="4"/>
              <rect x="72" y="24" width="44" height="72" rx="8" fill="#f59e0b" stroke="#111827" stroke-width="4"/>
            </svg>`
    },
    {
      es: 'Enfrente de', en: 'In front of',
      svg: `<svg viewBox="0 0 128 128" width="96" height="96" xmlns="http://www.w3.org/2000/svg">
              <circle cx="36" cy="64" r="16" fill="#60a5fa"/>
              <circle cx="92" cy="64" r="16" fill="#fbbf24"/>
              <path d="M52 64h24" stroke="#111827" stroke-width="6" marker-end="url(#arr)"/>
              <defs>
                <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" fill="#111827"/>
                </marker>
              </defs>
            </svg>`
    },
    {
      es: 'Tome el ascensor', en: 'Take the elevator',
      svg: `<svg viewBox="0 0 128 128" width="96" height="96" xmlns="http://www.w3.org/2000/svg">
              <rect x="20" y="16" width="88" height="96" rx="12" fill="#e5e7eb" stroke="#111827" stroke-width="4"/>
              <rect x="32" y="30" width="24" height="70" fill="#9ca3af"/>
              <rect x="72" y="30" width="24" height="70" fill="#9ca3af"/>
              <path d="M48 20l-8 -8l-8 8" stroke="#111827" stroke-width="4" fill="none"/>
              <path d="M96 20l-8 -8l-8 8" stroke="#111827" stroke-width="4" fill="none"/>
            </svg>`
    },
    {
      es: 'Vaya derecho', en: 'Go straight',
      svg: `<svg viewBox="0 0 128 128" width="96" height="96" xmlns="http://www.w3.org/2000/svg">
              <rect x="8" y="8" width="112" height="112" rx="16" fill="#e2e8f0"/>
              <path d="M64 100V28" stroke="#111827" stroke-width="10" stroke-linecap="round"/>
              <path d="M64 16l18 18H46z" fill="#111827"/>
            </svg>`
    }
  ];

  // Utility
  const byId = id => document.getElementById(id);
  const shuffleArray = arr => arr.map(v=>[Math.random(), v]).sort((a,b)=>a[0]-b[0]).map(v=>v[1]);

  let order = [...Array(CARDS.length).keys()];
  let index = 0; let score = 0; let answered = false;

  const els = { icon: byId('icon'), es: byId('es'), en: byId('en'), options: byId('options'), hint: byId('hint'), progress: byId('progress'), score: byId('score') };

  function speak(text){
    if(!('speechSynthesis' in window)) return;
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'es-MX';
    u.rate = 0.95; u.pitch = 1; u.volume = 1;
    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(u);
  }

  function makeOptions(correctIdx, field){
    const correct = CARDS[correctIdx][field];
    const pool = CARDS.map(c=>c[field]).filter(v=>v!==correct);
    const distractors = shuffleArray(pool).slice(0,3);
    return shuffleArray([correct, ...distractors]);
  }

  function render(){
    const mode = byId('mode').value;
    const card = CARDS[ order[index] ];
    els.icon.innerHTML = card.svg;

    // Reset
    answered = false; els.options.innerHTML = '';

    if(mode === 'es2en'){
      els.es.textContent = card.es;
      els.en.textContent = '—';
      els.hint.textContent = 'Pick the correct English meaning:';
      makeOptions(order[index], 'en').forEach(text=>{
        const b = document.createElement('button'); b.className='opt'; b.textContent=text; b.onclick=()=>check(text, card.en, b); els.options.appendChild(b);
      });
    }
    else if(mode === 'en2es'){
      els.es.textContent = '—';
      els.en.textContent = card.en;
      els.hint.textContent = 'Elige el significado en español:';
      makeOptions(order[index], 'es').forEach(text=>{
        const b = document.createElement('button'); b.className='opt'; b.textContent=text; b.onclick=()=>check(text, card.es, b); els.options.appendChild(b);
      });
    }
    else { // icon mode
      els.es.textContent = '—';
      els.en.textContent = '—';
      els.hint.textContent = 'What does this illustration mean? (English)';
      makeOptions(order[index], 'en').forEach(text=>{
        const b = document.createElement('button'); b.className='opt'; b.textContent=text; b.onclick=()=>check(text, card.en, b); els.options.appendChild(b);
      });
    }

    els.progress.textContent = `Card ${index+1} / ${CARDS.length}`;
    els.score.textContent = `Score ${score}`;
  }

  function check(choice, answer, btn){
    if(answered) return; answered = true;
    const nodes = [...document.querySelectorAll('.opt')];
    nodes.forEach(n=>n.disabled=true);
    if(choice === answer){ btn.classList.add('correct'); score++; } else { btn.classList.add('wrong'); nodes.find(n=>n.textContent===answer)?.classList.add('correct'); }

    // Reveal text lines
    const card = CARDS[ order[index] ];
    byId('es').textContent = card.es;
    byId('en').textContent = card.en;
    els.score.textContent = `Score ${score}`;
  }

  function next(){
    index = (index + 1) % order.length; render();
  }

  // Wire up controls
  byId('reveal').addEventListener('click', ()=>{
    if(answered) return; // already revealed by answer
    const card = CARDS[ order[index] ];
    byId('es').textContent = card.es;
    byId('en').textContent = card.en;
  });
  byId('next').addEventListener('click', next);
  byId('shuffle').addEventListener('click', ()=>{
    order = shuffleArray(order); index = 0; score = 0; render();
  });
  byId('mode').addEventListener('change', render);
  byId('speak').addEventListener('click', ()=>{
    const card = CARDS[ order[index] ]; speak(card.es);
  });

  // Init
  order = shuffleArray(order);
  render();
  </script>
</body>
</html>
